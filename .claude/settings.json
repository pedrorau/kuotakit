{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/agent/guard_paths.py",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/agent/protect_tests.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/agent/guard_commands.py",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/agent/protect_tests.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/agent/check_changed.py",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/scripts/agent/check_tests.py",
            "timeout": 900,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
