# Copy to .env (git-ignored) and change the password. Never commit real values.
POSTGRES_DB=kuotakit
POSTGRES_USER=kuotakit
POSTGRES_PASSWORD=change-me

# API keys, comma separated. Make them long and random, for example: echo "pk_$(openssl rand -hex 24)"
# KUOTAKIT_APP_KEYS goes inside your mobile app (it is not a secret); KUOTAKIT_SECRET_KEYS stays on your servers.
KUOTAKIT_APP_KEYS=pk_change_me_to_a_long_random_value
KUOTAKIT_SECRET_KEYS=sk_change_me_to_a_long_random_value

# Google Play (optional, see docs/google-play-setup.md). Without it the receipts endpoint answers 502 and grants nothing.
# Used with: docker compose -f docker-compose.yml -f docker-compose.google.yml up
# KUOTAKIT_GOOGLE_PACKAGE_NAME=com.example.app

# Play notifications webhook (renewals, cancellations, refunds). Both or none, only with the Google settings above.
# KUOTAKIT_GOOGLE_PUBSUB_AUDIENCE=https://kuotakit.example.com/v1/webhooks/google
# KUOTAKIT_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@my-project.iam.gserviceaccount.com
