<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <!-- The OpenAPI libraries log a stack trace while they decide whether a text is a location or the document itself. -->
  <logger name="io.swagger" level="OFF"/>
  <logger name="com.networknt" level="ERROR"/>
  <logger name="com.atlassian" level="WARN"/>
  <root level="INFO"><appender-ref ref="STDOUT"/></root>
</configuration>
